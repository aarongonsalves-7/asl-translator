---
import '../styles/global.css';
import NavIcon from '../ui/NavIcon.astro';

interface Props {
  title: string;
  description?: string;
  path: string;
  section: string;
  noindex?: boolean;
}

const {
  title,
  description = 'A webcam ASL fingerspelling translator that runs entirely on your device. Every stage tells you what the recogniser can see and what to do next.',
  path,
  section,
  noindex = false,
} = Astro.props;
const canonical = Astro.site && !noindex ? new URL(path, Astro.site).href : undefined;
const socialImage = Astro.site ? new URL('/social-preview.png', Astro.site).href : '/social-preview.png';

const nav = [
  { href: '/', label: 'Translate', section: 'Translate' },
  { href: '/alphabet/', label: 'Alphabet', section: 'Alphabet' },
  { href: '/settings/', label: 'Settings', section: 'Settings' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <meta name="robots" content={noindex || !Astro.site ? 'noindex, follow' : 'index, follow'} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="ASL Translator" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="ASL Translator — on-device fingerspelling, with alphabet and calibration tools" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content="ASL Translator — on-device fingerspelling" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline>
      // Resolve the effective theme before first paint so a dark-mode user never sees a white
      // flash, and so the sun/moon icon has a theme to key off without waiting for JS at the
      // bottom of the page.
      (() => {
        try {
          const saved = localStorage.getItem('asl-translator.theme');
          const systemDark = window.matchMedia?.('(prefers-color-scheme: dark)').matches;
          document.documentElement.dataset.theme =
            saved === 'light' || saved === 'dark' ? saved : systemDark ? 'dark' : 'light';
        } catch {
          /* storage disabled */
        }
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <nav class="global-nav" aria-label="Main">
      <div class="global-nav-inner">
        <a class="global-nav-brand" href="/"><svg class="brand-mark" viewBox="0 0 32 36" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M5 8v20M11 4v28M17 9v19M23 3v29M29 12v13" /></svg>ASL Translator</a>
        <div class="global-nav-links" id="nav-menu">
          {
            nav.map((item) => (
              <a
                class="global-nav-link"
                href={item.href}
                aria-label={item.label}
                title={item.label}
                aria-current={path === item.href ? 'page' : undefined}
              >
                <NavIcon name={item.label} />
                <span>{item.label}</span>
              </a>
            ))
          }
        </div>
        <div class="global-nav-actions">
          <button type="button" class="btn btn-ghost theme-toggle" id="theme-toggle">
            <!-- Sun marks the light theme, moon the dark theme. CSS reveals one per theme. -->
            <svg
              class="theme-icon theme-icon-sun"
              viewBox="0 0 24 24"
              width="18"
              height="18"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              aria-hidden="true"
            >
              <circle cx="12" cy="12" r="4"></circle>
              <path
                d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M19.1 4.9l-1.4 1.4M6.3 17.7l-1.4 1.4"
              ></path>
            </svg>
            <svg
              class="theme-icon theme-icon-moon"
              viewBox="0 0 24 24"
              width="18"
              height="18"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
            </svg>
          </button>
          <button
            type="button"
            class="btn btn-ghost nav-toggle"
            id="nav-toggle"
            aria-label="Menu"
            aria-controls="nav-menu"
            aria-expanded="false"
          >
            <svg
              viewBox="0 0 24 24"
              width="18"
              height="18"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              aria-hidden="true"
            >
              <path d="M4 7h16M4 12h16M4 17h16"></path>
            </svg>
          </button>
        </div>
      </div>
    </nav>

    <main id="main-content" tabindex="-1" data-section={section}>
      {path !== '/' && <nav class="breadcrumbs tile-inner" aria-label="Breadcrumb"><a href="/">Translator</a><span aria-hidden="true"> / </span><span aria-current="page">{section}</span></nav>}
      <slot />
    </main>

    <footer class="site-footer">
      <div class="tile-inner">
        <div><span class="footer-brand">A little practice goes a long way.</span><p class="fine-print">
          Alphabet recognition only. It is a learning and accessibility aid, not a substitute for a
          qualified ASL interpreter. The camera stream and every landmark stay on this device.
        </p></div>
        <nav class="footer-links" aria-label="Bottom">
          {nav.map(item => <a class="global-nav-link" href={item.href} aria-label={item.label} title={item.label} aria-current={path === item.href ? 'page' : undefined}><NavIcon name={item.label} /><span>{item.label}</span></a>)}
        </nav>
        <nav class="legal-links" aria-label="Information"><a href="/privacy/">Privacy policy</a><a href="/terms/">Terms of use</a><a href="/#faq">FAQs</a></nav>
      </div>
    </footer>
    {['/', '/alphabet/', '/settings/'].includes(path) && <a class="mobile-cta btn btn-primary" href="/#translator">{path === '/' ? 'Go to camera controls' : 'Open translator'}</a>}

    <script is:inline>
      (() => {
        const root = document.documentElement;
        const button = document.getElementById('theme-toggle');
        const systemDark = () => window.matchMedia?.('(prefers-color-scheme: dark)').matches;
        const current = () => (root.dataset.theme === 'dark' || root.dataset.theme === 'light'
          ? root.dataset.theme
          : systemDark()
            ? 'dark'
            : 'light');

        if (button) {
          const sync = () => {
            const next = current() === 'dark' ? 'light' : 'dark';
            button.setAttribute('aria-label', `Switch to ${next} theme`);
            button.setAttribute('title', `Switch to ${next} theme`);
          };
          button.addEventListener('click', () => {
            const next = current() === 'dark' ? 'light' : 'dark';
            root.dataset.theme = next;
            try {
              localStorage.setItem('asl-translator.theme', next);
            } catch {
              /* storage disabled */
            }
            sync();
          });
          sync();
        }

        const navToggle = document.getElementById('nav-toggle');
        const navMenu = document.getElementById('nav-menu');
        if (navToggle && navMenu) {
          const setOpen = (open) => {
            navToggle.setAttribute('aria-expanded', String(open));
            if (open) navMenu.setAttribute('data-open', '');
            else navMenu.removeAttribute('data-open');
          };
          navToggle.addEventListener('click', () => {
            setOpen(navToggle.getAttribute('aria-expanded') !== 'true');
          });
          // Any navigation, or Escape, closes the panel.
          navMenu.addEventListener('click', (event) => {
            const target = event.target;
            if (target instanceof Element && target.closest('a')) setOpen(false);
          });
          document.addEventListener('keydown', (event) => {
            if (event.key === 'Escape') setOpen(false);
          });
        }
      })();
    </script>
  </body>
</html>
