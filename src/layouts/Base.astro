---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  path: string;
  section: string;
}

const {
  title,
  description = 'A webcam ASL fingerspelling translator that runs entirely on your device. Every stage tells you what the recogniser can see and what to do next.',
  path,
  section,
} = Astro.props;

const nav = [
  { href: '/', label: 'Translate', section: 'Translate' },
  { href: '/alphabet/', label: 'Alphabet', section: 'Alphabet' },
  { href: '/settings/', label: 'Settings', section: 'Settings' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>
      // Applied before first paint so a dark-mode user never sees a white flash.
      (() => {
        try {
          const saved = localStorage.getItem('asl-translator.theme');
          if (saved === 'light' || saved === 'dark') {
            document.documentElement.dataset.theme = saved;
          }
        } catch {
          /* storage disabled */
        }
      })();
    </script>
  </head>
  <body>
    <!-- Global nav: true black, 44px, 12px links. -->
    <nav class="global-nav" aria-label="Main">
      <div class="global-nav-inner">
        <a class="global-nav-brand" href="/">ASL Translator</a>
        <div class="global-nav-links">
          {
            nav.map((item) => (
              <a
                class="global-nav-link"
                href={item.href}
                aria-current={path === item.href ? 'page' : undefined}
              >
                {item.label}
              </a>
            ))
          }
          <span class="global-nav-note">
            <span class="dot" aria-hidden="true"></span>On-device
          </span>
        </div>
      </div>
    </nav>

    <!-- Sub-nav: frosted parchment strip with the page name and its one action. -->
    <div class="sub-nav">
      <div class="sub-nav-inner">
        <span class="sub-nav-title">{section}</span>
        <div class="sub-nav-actions">
          <span class="sub-nav-note">Nothing leaves this device</span>
          <button type="button" class="pearl-capsule theme-toggle" id="theme-toggle">Theme</button>
        </div>
      </div>
    </div>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="tile-inner">
        <p class="fine-print">
          Alphabet recognition only. It is a learning and accessibility aid, not a substitute for a
          qualified ASL interpreter. The camera stream and every landmark stay on this device.
        </p>
        <div class="footer-links">
          <a href="/">Translate</a>
          <a href="/alphabet/">Alphabet</a>
          <a href="/settings/">Settings</a>
        </div>
      </div>
    </footer>

    <script is:inline>
      (() => {
        const button = document.getElementById('theme-toggle');
        if (!button) return;
        const systemDark = () => window.matchMedia?.('(prefers-color-scheme: dark)').matches;
        const current = () => document.documentElement.dataset.theme ?? (systemDark() ? 'dark' : 'light');
        const sync = () => {
          button.textContent = current() === 'dark' ? 'Light' : 'Dark';
          button.setAttribute('aria-label', `Switch to ${current() === 'dark' ? 'light' : 'dark'} theme`);
        };
        button.addEventListener('click', () => {
          const next = current() === 'dark' ? 'light' : 'dark';
          document.documentElement.dataset.theme = next;
          try {
            localStorage.setItem('asl-translator.theme', next);
          } catch {
            /* storage disabled */
          }
          sync();
        });
        sync();
      })();
    </script>
  </body>
</html>
