---
import Base from '../layouts/Base.astro';
import TranslateApp from '../ui/TranslateApp';
---

<Base
  title="ASL Translator — fingerspelling from your camera"
  description="Spell ASL letters to your webcam and read them back as text. Runs on-device, explains every stage, and needs no account."
  path="/"
  section="Translate"
>
  <section class="tile tile-white tile-hero">
    <div class="tile-inner">
      <p class="hero-kicker">Now reading A–Z fingerspelling in the browser</p>
      <h1 class="hero-display">Spell it with your hand.</h1>
      <p class="lead">
        Hold an ASL letter in front of the camera and it is added to the text — with every stage
        explained, so you can see what it can and cannot read.
      </p>
    </div>
  </section>

  <TranslateApp client:only="react">
    <div slot="fallback" class="tile tile-dark">
      <div class="tile-inner">
        <p class="output-empty">Starting the translator…</p>
      </div>
    </div>
  </TranslateApp>
</Base>
