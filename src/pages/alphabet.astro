---
import Base from '../layouts/Base.astro';
import { LETTER_LIST } from '../classify/letters';
import AlphabetPreview from '../ui/AlphabetPreview';

// Built from the same rule table the recogniser scores against, so this page cannot drift out
// of sync with what the app actually recognises.
const letters = LETTER_LIST;
const motionLetters = letters.filter((rule) => rule.motion).map((rule) => rule.letter);
---

<Base
  title="ASL alphabet — handshapes the translator recognises"
  description="All 26 ASL fingerspelling handshapes, with how to form each one and which letters are worth checking if the translator hesitates."
  path="/alphabet/"
  section="Alphabet"
>
  <section class="tile tile-white tile-hero">
    <div class="tile-inner">
      <h1 class="display-lg">Get to know the alphabet.</h1>
      <p class="lead lead-wide">
        These are the exact descriptions the recogniser scores against — including the two letters
        that only exist in motion.
      </p>
      <nav class="alphabet-index" aria-label="Jump to a letter">{letters.map(rule => <a href={`#letter-${rule.letter}`}>{rule.letter}</a>)}</nav>
    </div>
  </section>

  <section class="tile tile-parchment">
    <div class="tile-inner">
      <div class="section-head">
        <h2 class="tagline">A to Z</h2>
        <p class="section-note">
          {motionLetters.length} motion letters: {motionLetters.join(', ')}
        </p>
      </div>
      <AlphabetPreview client:load />
      <p>Compare with signer demonstrations at <a href="https://www.lifeprint.com/asl101/fingerspelling/abc.htm">ASL University</a> and <a href="https://www.handspeak.com/topic/408/">HandSpeak</a>. A skeleton cannot establish skin contact or linguistic correctness.</p>
    </div>
  </section>

  <section class="tile tile-white">
    <div class="tile-inner">
      <div class="section-head">
        <h2 class="display-md">Reading the tricky ones.</h2>
      </div>
      <p class="prose">
        A and S differ in whether the thumb rests alongside or across the fist. E bends the
        fingertips toward the bent thumb. O closes the gap left open in C. M, N and T differ
        in how many fingers cover the thumb and where it emerges. If the translator hesitates, the stage
        banner names the constraint that is closest to failing — usually the thumb.
      </p>
    </div>
  </section>
</Base>
