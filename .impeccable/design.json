      "description": "Labeled action with native disabled and keyboard focus behavior.",
      "html": "<button type=\"button\" class=\"ds-btn-quiet\">Space</button>",
      "css": ".ds-btn-quiet{font-family:var(--font-text,'InterVar','Segoe UI',sans-serif);display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:46px;padding:12px 20px;border:1px solid transparent;border-radius:8px;font-size:14px;font-weight:600;line-height:1.35;cursor:pointer;transition:background-color 160ms var(--ease-out,cubic-bezier(.22,1,.36,1)),border-color 160ms var(--ease-out,cubic-bezier(.22,1,.36,1));background:var(--surface-strong,#d8e9df);color:var(--ink,#13332f);}.ds-btn-quiet:hover:not(:disabled){background:var(--hairline,#cbded2);}.ds-btn-quiet:focus-visible{outline:3px solid var(--primary,#075e58);outline-offset:4px;}.ds-btn-quiet:disabled{opacity:.45;cursor:not-allowed;}@media(prefers-reduced-motion:reduce){.ds-btn-quiet{transition-duration:.001ms;}}",
      "refersTo": "button-quiet"
    },
    {
      "name": "Signing Hand Select",
      "kind": "input",
      "description": "Native selection used by alphabet inspection.",
      "html": "<label class=\"ds-select-label\">Signing hand <select class=\"ds-select\"><option>Right</option><option>Left</option></select></label>",
      "css": ".ds-select-label{font-family:var(--font-text,'InterVar','Segoe UI',sans-serif);color:var(--ink,#13332f);display:flex;align-items:center;gap:10px;font-size:13px;}.ds-select{font-family:var(--font-text,'InterVar','Segoe UI',sans-serif);min-height:44px;padding:8px 12px;border:1px solid var(--hairline-strong,#8da99b);border-radius:6px;background:var(--surface-card,#ffffff);color:var(--ink,#13332f);}.ds-select:focus-visible{outline:3px solid var(--primary,#075e58);outline-offset:4px;}",
      "refersTo": "select"
    },
    {
      "name": "Motion Tag",
      "kind": "chip",
      "description": "Informational tag on letters that require movement.",
      "html": "<span class=\"ds-motion-tag\">Motion</span>",
      "css": ".ds-motion-tag{font-family:var(--font-text,'InterVar','Segoe UI',sans-serif);display:inline-block;border-radius:4px;padding:4px 8px;background:var(--surface-strong,#d8e9df);color:var(--primary,#075e58);font-size:11px;font-weight:550;}",
      "refersTo": "motion-tag"
    },
    {
      "name": "Transcript",
      "kind": "card",
      "description": "Reading work area with the implemented empty state.",
      "html": "<section class=\"ds-transcript\" aria-label=\"Translated text\"><h2>Your text</h2><p><strong>Your first letter starts here.</strong><small>Open your hand to the camera, form a letter and hold it for a moment.</small></p></section>",
      "css": ".ds-transcript{font-family:var(--font-text,'InterVar','Segoe UI',sans-serif);display:flex;flex-direction:column;gap:18px;min-height:460px;padding:26px;border:1px solid var(--hairline,#cbded2);border-radius:14px;background:var(--surface-card,#ffffff);color:var(--ink,#13332f);}.ds-transcript h2{margin:0;font-size:18px;font-weight:600;}.ds-transcript p{max-width:25ch;margin:22px 0;color:var(--muted,#527067);line-height:1.6;}.ds-transcript strong{display:block;margin-bottom:12px;color:var(--body,#365d54);font-size:28px;font-weight:500;line-height:1.3;letter-spacing:-.025em;}.ds-transcript small{display:block;font-size:14px;}@media(max-width:640px){.ds-transcript{padding:22px;min-height:320px;}.ds-transcript strong{font-size:24px;}}",
      "refersTo": "transcript"
    },
    {
      "name": "Primary Navigation",
      "kind": "nav",
      "description": "Labeled destinations with native current-page state.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Main\"><a href=\"#translate\" aria-current=\"page\">Translate</a><a href=\"#alphabet\">Alphabet</a><a href=\"#settings\">Settings</a></nav>",
      "css": ".ds-nav{font-family:var(--font-text,'InterVar','Segoe UI',sans-serif);display:flex;flex-wrap:wrap;gap:6px;padding:12px;background:#075e58;color:#ffffff;}.ds-nav a{display:inline-flex;align-items:center;min-height:44px;padding:10px 16px;border-radius:8px;color:inherit;font-size:14px;font-weight:500;text-decoration:none;}.ds-nav a:hover{background:#ffffff18;}.ds-nav a[aria-current=\"page\"]{background:#ffffff24;box-shadow:inset 0 -2px 0 var(--highlight,#f4db68);}.ds-nav a:focus-visible{outline:3px solid var(--highlight,#f4db68);outline-offset:4px;}"
    },
    {
      "name": "Native Calibration Range",
      "kind": "input",
      "description": "Native range retains keyboard adjustment and visible focus.",
      "html": "<label class=\"ds-range-label\">Hold time<input class=\"ds-range\" type=\"range\" min=\"200\" max=\"1500\" value=\"600\" aria-valuetext=\"0.60 seconds\"></label>",
      "css": ".ds-range-label{font-family:var(--font-text,'InterVar','Segoe UI',sans-serif);display:grid;gap:8px;color:var(--ink,#13332f);font-size:15px;font-weight:600;}.ds-range{width:100%;min-height:44px;margin:0;accent-color:var(--primary,#075e58);cursor:pointer;}.ds-range:focus-visible{outline:3px solid var(--primary,#075e58);outline-offset:4px;}"
    },
    {
      "name": "Native Checkbox",
      "kind": "input",
      "description": "Native checkbox with a generous interaction area.",
      "html": "<label class=\"ds-check-label\">Show hand overlay<span class=\"ds-check-target\"><input class=\"ds-check\" type=\"checkbox\" checked></span></label>",
      "css": ".ds-check-label{font-family:var(--font-text,'InterVar','Segoe UI',sans-serif);display:flex;justify-content:space-between;align-items:start;gap:24px;color:var(--ink,#13332f);font-size:15px;font-weight:600;}.ds-check-target{display:flex;align-items:center;justify-content:center;min-width:48px;min-height:44px;}.ds-check{width:22px;height:22px;accent-color:var(--primary,#075e58);cursor:pointer;}.ds-check:focus-visible{outline:3px solid var(--primary,#075e58);outline-offset:4px;}"
    }
  ],
  "narrative": {
    "northStar": "Learning commons",
    "overview": "An approachable practice tool with the calm of an indoor daylight learning space. Deep teal navigation, green-tinted reading grounds and clear work surfaces give the interface a recognizable home. Direct, encouraging language makes room for a beginner to try, inspect feedback and try again.\n\nThe system puts useful controls and readable observations first. Its personality comes from color, measured typography, procedural hand illustrations and connected recognition feedback. Dark mode keeps the same hierarchy with green-toned surfaces. The product name travels with a clear individual-fingerspelling scope.",
    "keyCharacteristics": [
      "Pale green grounds and a deep teal navigation anchor.",
      "One self-hosted variable sans family with a compact, readable hierarchy.",
      "Bordered work areas, rectangular controls and restrained depth.",
      "Visible, truthful recognition states and user-controlled educational motion."
    ],
    "rules": [
      {
        "name": "The Named State Rule",
        "body": "Color supports a named observation or action; it never supplies recognition meaning by itself.",
        "section": "colors"
      },
      {
        "name": "The One Family Rule",
        "body": "Use InterVar across display, reading and controls; reserve the existing monospace stack for inline code.",
        "section": "typography"
      },
      {
        "name": "The Flat Workarea Rule",
        "body": "Separate work areas with surface tone and a hairline rather than decorative elevation.",
        "section": "elevation"
      },
      {
        "name": "The Purposeful Motion Rule",
        "body": "Motion communicates recognition progress or explicitly requested educational movement. Reduced-motion preference disables smooth scrolling and reduces CSS animation/transition duration; educational playback remains user-controlled.",
        "section": "components"
      }
    ],
    "dos": [
      "**Do** use theme-aware green surfaces and the self-hosted InterVar stack.",
      "**Do** preserve clear labels, visible keyboard focus and native form/disclosure behavior.",
      "**Do** show observation, uncertainty and a useful next action alongside recognition color.",
      "**Do** use inline outline SVG icons with surrounding text labels.",
      "**Do** preserve active feed proportions and put camera before output on narrow screens."
    ],
    "donts": [
      "**Don't** restore the former serif, pill-button, gradient-orb or layered legacy theme authority.",
      "**Don't** present procedural previews or constraint scores as validated linguistic or accuracy evidence.",
      "**Don't** add decorative entrance, idle or icon animation to the practice workspace.",
      "**Don't** turn recognition steps into persistent completion badges or cover phone content with a fixed footer action."
    ]
  }
}
