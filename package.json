{
  "name": "asl-camera-translator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "On-device webcam ASL fingerspelling translator (A-Z) with an explainable, stage-based recognition UI.",
  "scripts": {
    "predev": "node scripts/prepare-assets.mjs",
    "dev": "astro dev",
    "prebuild": "node scripts/prepare-assets.mjs",
    "build": "astro check && astro build",
    "preview": "astro preview --port 4173 --host 127.0.0.1",
    "assets": "node scripts/prepare-assets.mjs",
    "typecheck": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.1",
    "@mediapipe/tasks-vision": "1.1.1",
    "astro": "^7.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
